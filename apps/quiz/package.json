{
  "name": "@ai-in-learning/quiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/check-bundle.ts",
    "check-bundle": "node scripts/check-bundle.ts",
    "dev": "vite",
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "@ai-in-learning/core": "workspace:*",
    "@ai-in-learning/shared-types": "workspace:*",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/javascript": "1.5.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0"
  }
}
