# Environment variables of the API (plan §14). Names only: never commit values.
# For local development, copy this file to `.env` (ignored by git) and fill it in.

# Key of the quiz's dedicated Anthropic workspace.
ANTHROPIC_API_KEY=

# Upstash Redis REST endpoint (https://…) and token, for rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC key for exercise tokens, at least 32 characters. For example: openssl rand -hex 32
QUIZ_SIGNING_SECRET=
