{
  "name": "@ai-in-learning/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "source": "./src/runner/index.ts",
      "types": "./dist/runner/index.d.ts",
      "default": "./dist/runner/index.js"
    },
    "./server": {
      "source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/testing": {
      "source": "./src/server/testing/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-in-learning/shared-types": "workspace:*",
    "@anthropic-ai/sdk": "1.9.0",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.6.7"
  }
}
